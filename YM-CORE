<!DOCTYPE html>
<html lang="ja" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YM-CORE High-Speed Edition</title>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
    :root[data-theme="light"] {
        --primary-color: #1a365d;
        --secondary-color: #2b6cb0;
        --accent-red: #e53e3e;
        --bg-color: #f7fafc;
        --chat-bg: #edf2f7;
        --user-msg-bg: #2b6cb0;
        --bot-msg-bg: #ffffff;
        --text-color: #2d3748;
        --panel-bg: #ffffff;
        --border-color: #cbd5e0;
    }

    :root[data-theme="dark"] {
        --primary-color: #0f172a;
        --secondary-color: #3b82f6;
        --accent-red: #ef4444;
        --bg-color: #020617;
        --chat-bg: #0f172a;
        --user-msg-bg: #2563eb;
        --bot-msg-bg: #1e293b;
        --text-color: #f8fafc;
        --panel-bg: #1e293b;
        --border-color: #334155;
    }

    * { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg-color); margin: 0; padding: 0; display: flex; justify-content: center; height: 100vh; color: var(--text-color); transition: background 0.3s; }
    .chat-container { width: 100%; max-width: 650px; height: 100vh; background: var(--chat-bg); display: flex; flex-direction: column; box-shadow: 0 4px 20px rgba(0,0,0,0.2); }
    
    .header { background: var(--primary-color); color: white; padding: 12px 16px; font-weight: bold; font-size: 1rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); }
    .header-controls { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; }
    .icon-toggle-btn { background: rgba(255,255,255,0.15); border: none; color: white; padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 12px; }
    .icon-toggle-btn:hover { background: rgba(255,255,255,0.3); }

    .settings-panel { background: var(--panel-bg); padding: 12px 16px; border-bottom: 1px solid var(--border-color); display: none; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 0.85rem; }
    .settings-panel.active { display: grid; }
    .setting-item { display: flex; flex-direction: column; gap: 4px; }

    .messages { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; scroll-behavior: smooth; }
    .msg-wrapper { display: flex; flex-direction: column; max-width: 85%; }
    .msg-wrapper.bot { align-self: flex-start; }
    .msg-wrapper.user { align-self: flex-end; }
    
    .msg { padding: 12px 16px; border-radius: 12px; font-size: 14.5px; line-height: 1.6; word-break: break-word; box-shadow: 0 2px 5px rgba(0,0,0,0.05); position: relative; }
    .msg.bot { background: var(--bot-msg-bg); color: var(--text-color); border-top-left-radius: 2px; }
    .msg.user { background: var(--user-msg-bg); color: white; border-top-right-radius: 2px; }

    .msg p { margin: 0 0 8px 0; }
    .msg p:last-child { margin-bottom: 0; }
    
    .msg-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; }
    .time-stamp { font-size: 10px; color: #a0aec0; }
    
    .speech-btn { background: none; border: none; font-size: 12px; cursor: pointer; color: #718096; padding: 2px 6px; border-radius: 4px; }

    .file-preview { font-size: 11px; background: rgba(0,0,0,0.05); padding: 4px 8px; border-radius: 4px; display: none; align-items: center; justify-content: space-between; margin: 0 12px 4px; }
    .file-preview.active { display: flex; }

    .input-area { background: var(--panel-bg); padding: 12px; display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--border-color); }
    .input-controls { display: flex; gap: 8px; align-items: flex-end; }
    
    textarea { flex: 1; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 12px; outline: none; font-size: 14px; resize: none; max-height: 120px; font-family: inherit; background: var(--chat-bg); color: var(--text-color); }
    
    .input-info { display: flex; justify-content: space-between; align-items: center; font-size: 10.5px; color: #a0aec0; padding: 0 4px; }

    .icon-btn { background: var(--chat-bg); color: var(--text-color); border: 1px solid var(--border-color); width: 40px; height: 40px; border-radius: 10px; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
    .icon-btn:hover { background: var(--border-color); }
    
    .icon-btn.recording { background: var(--accent-red); color: white; border-color: var(--accent-red); animation: pulse 1.5s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(229, 62, 62, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(229, 62, 62, 0); } 100% { box-shadow: 0 0 0 0 rgba(229, 62, 62, 0); } }

    button.send-btn { background: var(--secondary-color); color: white; border: none; padding: 0 18px; border-radius: 10px; font-weight: bold; cursor: pointer; height: 40px; }
    button.send-btn:disabled, .icon-btn:disabled { background: var(--border-color); cursor: not-allowed; animation: none; }
</style>
</head>
<body>

<div class="chat-container">
    <div class="header">
        <span>YM-CORE Speed Max</span>
        <div class="header-controls">
            <button class="icon-toggle-btn" onclick="toggleSettings()" title="設定">⚙️ 設定</button>
            <button class="icon-toggle-btn" onclick="toggleTheme()" title="テーマ切替">🌓</button>
            <button class="icon-toggle-btn" onclick="clearHistory()" title="履歴クリア">🗑️</button>
        </div>
    </div>

    <div id="settingsPanel" class="settings-panel">
        <div class="setting-item">
            <label>話速 (Rate): <span id="rateValue">1.0</span>x</label>
            <input type="range" id="speechRate" min="0.5" max="2.0" step="0.1" value="1.0" oninput="document.getElementById('rateValue').innerText=this.value">
        </div>
        <div class="setting-item">
            <label>音高 (Pitch): <span id="pitchValue">1.0</span></label>
            <input type="range" id="speechPitch" min="0.5" max="1.5" step="0.1" value="1.0" oninput="document.getElementById('pitchValue').innerText=this.value">
        </div>
    </div>

    <div id="messages" class="messages"></div>

    <div id="filePreview" class="file-preview">
        <span id="fileName">ファイル名</span>
        <button onclick="removeFile()" style="border:none; background:none; cursor:pointer; color:red;">✕</button>
    </div>

    <div class="input-area">
        <div class="input-controls">
            <input type="file" id="fileInput" style="display:none" onchange="handleFileSelect(event)">
            <button class="icon-btn" onclick="document.getElementById('fileInput').click()" title="ファイルを添付">📎</button>
            <textarea id="userInput" rows="1" placeholder="メッセージを入力..." onkeydown="handleKeyDown(event)" oninput="handleInput(this)"></textarea>
            <button id="micBtn" class="icon-btn" onclick="toggleSpeechRecognition()" title="音声入力">🎤</button>
            <button id="sendBtn" class="send-btn" onclick="sendMsg()">送信</button>
        </div>
        <div class="input-info">
            <label><input type="checkbox" id="autoTTS" checked> 自動読み上げ</label>
            <span id="charCounter">0 文字</span>
        </div>
    </div>
</div>

<script>
let history = [];
let attachedFileText = "";

// ⭐️ 高速化設定 1: 送信履歴件数を絞ってAPI処理を軽くする (10件 → 3件)
const MAX_HISTORY = 3; 

// ⭐️ 高速化設定 2: 短文・簡潔回答を促すプロンプト
const SYSTEM_PROMPT = "あなたの名前は『YM-CORE』です。要点を絞り、極めて簡潔・迅速に回答してください。";

function toggleTheme() {
    const current = document.documentElement.getAttribute("data-theme");
    document.documentElement.setAttribute("data-theme", current === "dark" ? "light" : "dark");
}

function toggleSettings() {
    document.getElementById("settingsPanel").classList.toggle("active");
}

function handleInput(textarea) {
    textarea.style.height = 'auto';
    textarea.style.height = Math.min(textarea.scrollHeight, 120) + 'px';
    document.getElementById("charCounter").innerText = `${textarea.value.length} 文字`;
}

function handleFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(evt) {
        attachedFileText = `\n\n【添付ファイル: ${file.name}】\n${evt.target.result}`;
        document.getElementById("fileName").innerText = `📎 ${file.name} (${Math.round(file.size/1024)}KB)`;
        document.getElementById("filePreview").classList.add("active");
    };
    reader.readAsText(file);
}

function removeFile() {
    attachedFileText = "";
    document.getElementById("fileInput").value = "";
    document.getElementById("filePreview").classList.remove("active");
}

function saveHistory() {
    localStorage.setItem("ym_core_speed_history", JSON.stringify(history));
}

function loadHistory() {
    const saved = localStorage.getItem("ym_core_speed_history");
    if (saved) {
        history = JSON.parse(saved);
        history.forEach(item => appendMsg(item.content, item.role === "user" ? "user" : "bot", true, false));
    } else {
        appendMsg("こんにちは。**YM-CORE High-Speed** です。<br>ストリーミング表示に対応し、回答速度を極限まで引き上げました。", "bot", true, false);
    }
}

function clearHistory() {
    if (confirm("会話履歴をクリアしますか？")) {
        history = [];
        localStorage.removeItem("ym_core_speed_history");
        document.getElementById("messages").innerHTML = "";
        appendMsg("履歴をクリアしました。", "bot", false, false);
    }
}

/* 音声認識 & 合成 Engine */
const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
let recognition = null;
let isRecording = false;

if (SpeechRecognition) {
    recognition = new SpeechRecognition();
    recognition.lang = 'ja-JP';
    recognition.onstart = () => {
        isRecording = true;
        document.getElementById("micBtn").classList.add("recording");
    };
    recognition.onresult = (e) => {
        document.getElementById("userInput").value = e.results[0][0].transcript;
        handleInput(document.getElementById("userInput"));
    };
    recognition.onend = () => {
        isRecording = false;
        document.getElementById("micBtn").classList.remove("recording");
        if (document.getElementById("userInput").value.trim()) sendMsg();
    };
}

function toggleSpeechRecognition() {
    if (!recognition) return alert("ブラウザが音声認識に対応していません");
    isRecording ? recognition.stop() : recognition.start();
}

function speakText(text) {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();

    const cleanText = text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[*_~`#\-]/g, '').trim();
    if (!cleanText) return;

    const utterance = new SpeechSynthesisUtterance(cleanText);
    utterance.lang = 'ja-JP';
    utterance.rate = parseFloat(document.getElementById("speechRate").value);
    utterance.pitch = parseFloat(document.getElementById("speechPitch").value);

    window.speechSynthesis.speak(utterance);
}

function handleKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMsg();
    }
}

// ⭐️ 高速化の核心: 1文字ずつ流れるストリーミング受信処理
async function sendMsg() {
    const input = document.getElementById("userInput");
    let text = input.value.trim();
    if (!text && !attachedFileText) return;

    if (attachedFileText) {
        text += attachedFileText;
        removeFile();
    }

    input.value = "";
    handleInput(input);

    appendMsg(text, "user", false, true);
    history.push({ role: "user", content: text });
    saveHistory();

    // 枠を即時生成し、1文字ずつ挿入していく
    const botMsgId = appendMsg("⚡...", "bot", false, true);
    const botMsgElem = document.getElementById(botMsgId);

    try {
        const response = await fetch("https://text.pollinations.ai/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                messages: [{ role: "system", content: SYSTEM_PROMPT }, ...history.slice(-MAX_HISTORY)],
                model: "openai",
                stream: true // ストリーミングモードON
            })
        });

        if (!response.ok) throw new Error();

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let fullReply = "";

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const chunk = decoder.decode(value, { stream: true });
            fullReply += chunk;
            
            // マークダウンとしてリアルタイム更新
            if (typeof marked !== 'undefined') {
                botMsgElem.innerHTML = marked.parse(fullReply);
            } else {
                botMsgElem.textContent = fullReply;
            }
            
            const box = document.getElementById("messages");
            box.scrollTop = box.scrollHeight;
        }

        history.push({ role: "assistant", content: fullReply });
        saveHistory();

        if (document.getElementById("autoTTS").checked) {
            speakText(fullReply);
        }

    } catch {
        botMsgElem.textContent = "エラーが発生しました。もう一度お試しください。";
    }
}

function appendMsg(text, type, isMarkdown = false, shouldScroll = true) {
    const box = document.getElementById("messages");
    const wrapper = document.createElement("div");
    wrapper.className = `msg-wrapper ${type.split(' ')[0]}`;

    const div = document.createElement("div");
    const id = "msg_" + Date.now();
    div.id = id;
    div.className = "msg " + type;

    div.innerHTML = isMarkdown && typeof marked !== 'undefined' ? marked.parse(text) : text;
    wrapper.appendChild(div);

    const footer = document.createElement("div");
    footer.className = "msg-footer";
    footer.innerHTML = `<span class="time-stamp">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>`;
    if (type.includes("bot")) {
        const btn = document.createElement("button");
        btn.className = "speech-btn";
        btn.innerText = "🔊 読み上げ";
        btn.onclick = () => speakText(div.innerText);
        footer.appendChild(btn);
    }
    wrapper.appendChild(footer);

    box.appendChild(wrapper);
    if (shouldScroll) box.scrollTop = box.scrollHeight;
    return id;
}

window.onload = loadHistory;
</script>

</body>
</html>
